{
  "name": "duzelo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db:static && npm run build",
    "test:db:static": "node scripts/verify-db-baseline.mjs",
    "db:start": "node scripts/db-local.mjs start",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:test": "node scripts/db-local.mjs test",
    "db:concurrency": "python3 scripts/db-concurrency.py",
    "db:advisors": "node scripts/db-local.mjs advisors",
    "db:lint": "node scripts/db-local.mjs lint",
    "db:explain": "node scripts/db-local.mjs explain",
    "auth:start": "supabase start --exclude realtime,imgproxy,studio,postgres-meta,edge-runtime,logflare,vector,supavisor,mailpit",
    "auth:env": "node scripts/auth-local-env.mjs",
    "test:auth": "node scripts/auth-test-runner.mjs",
    "security:check": "node scripts/check-secrets.mjs",
    "test:public": "node scripts/test-public.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "geist": "1.9.0",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
