{
  "name": "duzelo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db:static && npm run build",
    "test:db:static": "node scripts/verify-db-baseline.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "geist": "1.9.0",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": "24.x"
  }
}
