# Optional. Defaults work without credentials. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_NAME=Duzelo
NEXT_PUBLIC_APP_TAGLINE=Good help, close to home.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public SDK pair; account flows use the server-only settings below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Storage key; required only when worker review is explicitly enabled.
SUPABASE_SECRET_KEY=
# Auth OFF by default; explicit complete local/hosted config required to enable.
AUTH_ENABLED=false
# Sensitive capabilities stay OFF by default. Unimplemented ones reject true.
LOCATION_MATCHING_ENABLED=false
WORKER_APPROVAL_ENABLED=false
PAYMENTS_ENABLED=false
SMS_CRITICAL_ENABLED=false
WEB_PUSH_ENABLED=false
GOOGLE_OAUTH_ENABLED=false
EMAIL_AUTH_ENABLED=false
TEAM_DISPATCH_ENABLED=false
AI_ASSIST_ENABLED=false
RECURRING_JOBS_ENABLED=false

# M02 authentication remains OFF by default. Local config is generated by npm run auth:env.
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
AUTH_RATE_LIMIT_SECRET=
# Hosted SMS must be reviewed/configured in Supabase, with hCaptcha enabled there.
SMS_PROVIDER_APPROVED=false
NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=
AUTH_CAPTCHA_SECRET=

# M03 private worker evidence. Leave OFF for the public prelaunch deployment.
# Local test setup generates scanner settings; never expose clamd on the Internet.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TLS=false
# Hosted review additionally needs an approved retention policy and TLS scanner.
VERIFICATION_RETENTION_DAYS=
VERIFICATION_POLICY_APPROVED=false

# M04 public discovery remains OFF until dedicated hosting/privacy review.
DISCOVERY_ENABLED=false
DISCOVERY_POLICY_APPROVED=false
# Explicit licensed MapTiler style URLs; these use PUBLIC readonly/referrer-restricted keys.
MAP_LICENSE_APPROVED=false
MAP_STYLE_LIGHT_URL=
MAP_STYLE_DARK_URL=
# Geocoding uses a separate SERVER-ONLY provider key, never NEXT_PUBLIC_*.
GEOCODING_PROVIDER_APPROVED=false
MAPTILER_GEOCODING_KEY=
# Synthetic HTTP provider/map fixtures are generated only for isolated local tests.
DISCOVERY_TEST_MAP=false
GEOCODING_TEST_URL=

# M05 requests/matching remain OFF for the public prelaunch site.
JOB_REQUESTS_ENABLED=false
JOBS_POLICY_APPROVED=false
JOB_MEDIA_RETENTION_DAYS=
